{
  "name": "rowy-backend",
  "description": "cloud run instance for running Rowy's backend functionality",
  "version": "1.9.9",
  "private": true,
  "main": "build/index.js",
  "scripts": {
    "start": "node --enable-source-maps build/index.js",
    "build": "tsc;cpy --cwd=src --parents '**/*.json' ../build/",
    "deploy": "./deploy.sh --project"
  },
  "engines": {
    "node": "22"
  },
  "author": "Rowy Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@google-cloud/logging": "^10.3.1",
    "@google-cloud/secret-manager": "^4.1.4",
    "algoliasearch": "^4.10.5",
    "axios": "^0.21.4",
    "express": "^4.17.1",
    "file-type": "^16.5.3",
    "firebase-admin": "^13.3.0",
    "firebase-functions": "^6.3.2",
    "js-beautify": "^1.13.0",
    "google-auth-library": "^8.8.0",
    "lodash": "^4.17.21",
    "node-fetch": "^2.6.7",
    "sucrase": "^3.31.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "20.11.24",
    "cpy-cli": "^2.0.0",
    "firebase-tools": "^14.2.2",
    "typescript": "^4.6.0"
  }
}
