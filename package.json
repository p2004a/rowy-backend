{
  "name": "rowy-backend",
  "description": "cloud run instance for running Rowy's backend functionality",
  "version": "1.9.9",
  "private": true,
  "main": "build/index.js",
  "scripts": {
    "start": "node --enable-source-maps build/index.js",
    "build": "tsc;cpy --cwd=src --parents '**/*.json' ../build/",
    "deploy": "./deploy.sh --project"
  },
  "engines": {
    "node": "24"
  },
  "author": "Rowy Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@google-cloud/logging": "^11.2.1",
    "@google-cloud/secret-manager": "^6.1.1",
    "algoliasearch": "^5.49.2",
    "axios": "^0.21.4",
    "express": "^4.17.1",
    "file-type": "^16.5.3",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^15.11.0",
    "google-auth-library": "^10.6.2",
    "js-beautify": "^1.13.0",
    "lodash": "^4.17.23",
    "node-fetch": "^2.6.7",
    "sucrase": "^3.35.1",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/node": "^24",
    "cpy-cli": "^2.0.0"
  }
}
