{
  "name": "rowy-backend",
  "description": "cloud run instance for running Rowy's backend functionality",
  "version": "1.10.9+bar-fork",
  "private": true,
  "main": "build/index.js",
  "scripts": {
    "start": "node --enable-source-maps build/index.js",
    "build": "tsc;cpy --cwd=src '**/*.json' ../build/",
    "deploy": "./deploy.sh --project"
  },
  "engines": {
    "node": "26"
  },
  "author": "Rowy Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@google-cloud/logging": "^12.3.0",
    "@google-cloud/secret-manager": "^7.2.0",
    "algoliasearch": "^5.60.0",
    "express": "^5.3.0",
    "file-type": "^22.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "google-auth-library": "^11.3.1",
    "js-beautify": "^2.0.3",
    "lodash": "^4.18.1",
    "sucrase": "^3.35.1",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "cpy-cli": "^7.0.0"
  },
  "resolutions": {
    "superstatic": "^11.1.0"
  }
}
